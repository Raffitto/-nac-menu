# Copy to .env.local for local React dev (never commit .env.local).
# Frontend only — anon key is public by design; RLS protects data.

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: default branch for single-site builds
# REACT_APP_NAC_BRANCH_ID=khobar

# Unified Overview — single Operational Dashboard (no Session Analytics tab)
# Unified Operational Dashboard (default ON when REACT_APP_PLATFORM_MODE=admin)
# REACT_APP_UNIFIED_OVERVIEW=0   # opt out → legacy Overview Operations + Session tabs

# --- CLI only (never REACT_APP_*, never commit real values) ---
# Used by Supabase CLI when linking / db push (stored in OS keychain after login).
# SUPABASE_ACCESS_TOKEN=   # optional; prefer `supabase login`
# SUPABASE_DB_PASSWORD=    # optional; prompted on `supabase link` if omitted

# NEVER add SUPABASE_SERVICE_ROLE_KEY here or in Netlify public env.
